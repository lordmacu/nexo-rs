#!/bin/sh
# Pre-commit checks for nexo-rs.
#
# Runs fmt + clippy + tests. The docs-sync gate lives in
# `.githooks/commit-msg` (not here) because pre-commit fires
# BEFORE git writes the new commit message — it cannot reliably
# inspect the message for the `[no-docs]` opt-out tag, which
# made it misfire for `git commit -m`/`-F` flows.
#
# Install once per clone:
#     git config core.hooksPath .githooks
# or re-run ./scripts/bootstrap.sh which wires this for you.

set -e

echo ">> fmt check..."
cargo fmt --all -- --check

echo ">> clippy..."
cargo clippy --workspace -- -D warnings

echo ">> tests..."
# nextest per CLAUDE.md project convention. `cargo test --workspace`
# was flaky under the heavy parallel-scheduling default (e.g.
# crates/driver-loop/tests/workspace_git_worktree_test.rs raced on
# tempdir/git-init under load); nextest's runner schedules cleanly.
# --status-level=fail keeps the hook quiet on green, loud on red.
cargo nextest run --workspace --status-level=fail

echo ">> ok"
